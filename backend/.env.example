# ============================================================================
# EduPulse Backend — Environment Variables
# Copy this file to .env and fill in real values before running the server.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins (e.g. your deployed
# Netlify frontend URL). CLIENT_URL is always allowed.
ADDITIONAL_CORS_ORIGINS=

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edupulse?schema=public"

# --- JWT Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Bcrypt -------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# --- Cloudinary (file uploads: avatars, gate pass QR, announcement images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Nodemailer (email notifications, password reset) ------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduPulse ERP
SMTP_FROM_EMAIL=no-reply@edupulse.edu

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- AI module (optional — used by /api/v1/ai endpoints for richer answers) ---
# If left blank, the AI endpoints fall back to the same deterministic
# rule-based engine the frontend currently ships with (ChatContext.tsx),
# so the system runs fully out of the box with zero external dependencies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Demo/dev only: simulates live GPS movement for seeded buses every few
# seconds so BusTracker.tsx has something to watch without a real driver app.
# Leave false in production.
ENABLE_BUS_SIMULATOR=false
